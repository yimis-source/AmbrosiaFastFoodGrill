<Project Sdk="Microsoft.NET.Sdk">

  <!-- Aplicación de escritorio Windows Forms: caja, cocina, pedidos e inventario -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Ambrosia.Escritorio</RootNamespace>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <!-- Permite compilar también desde Linux o macOS (para ejecutarla se necesita Windows) -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ambrosia.Nucleo\Ambrosia.Nucleo.csproj" />
  </ItemGroup>

</Project>
