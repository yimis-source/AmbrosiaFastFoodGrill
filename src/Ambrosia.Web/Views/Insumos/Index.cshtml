@model InsumosIndexViewModel
@{
    ViewData["Title"] = "Inventario";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h3 mb-0">📦 Inventario de insumos</h1>
        <div class="text-muted small">Valor en bodega: <strong>@Model.ValorInventario.ComoPesos()</strong></div>
    </div>
    <a class="btn btn-fuego" asp-action="Crear">➕ Nuevo insumo</a>
</div>

@if (Model.Alertas.Count > 0)
{
    <div class="alert alert-warning shadow-sm">
        <div class="fw-semibold mb-1">⚠️ Comprar pronto (del más urgente al menos urgente)</div>
        <ol class="mb-0 small">
            @foreach (var a in Model.Alertas)
            {
                <li>
                    <strong>@a.Nombre</strong>: @a.StockActual.ComoCantidad(a.Unidad)
                    de un mínimo de @a.StockMinimo.ComoCantidad(a.Unidad)
                    (@((a.NivelStock * 100).ComoNumero(0)) %)
                </li>
            }
        </ol>
    </div>
}

<div class="table-responsive shadow-sm rounded">
    <table class="table table-striped table-hover align-middle mb-0 bg-white">
        <thead class="table-dark">
            <tr>
                <th>Insumo</th>
                <th class="text-end">Stock</th>
                <th class="text-end d-none d-md-table-cell">Mínimo</th>
                <th class="d-none d-lg-table-cell" style="width: 18%">Nivel</th>
                <th class="text-end d-none d-md-table-cell">Costo</th>
                <th style="min-width: 210px">Ingresar compra</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var i in Model.Insumos)
            {
                var porcentaje = Math.Clamp(i.NivelStock * 50, 0, 100);   // 2× el mínimo = barra llena
                <tr class="@(i.BajoMinimo ? "table-danger" : "")">
                    <td>
                        <div class="fw-semibold">@i.Nombre</div>
                        <div class="small text-muted d-md-none">mín. @i.StockMinimo.ComoCantidad(i.Unidad)</div>
                    </td>
                    <td class="text-end text-nowrap">@i.StockActual.ComoCantidad(i.Unidad)</td>
                    <td class="text-end text-nowrap d-none d-md-table-cell">@i.StockMinimo.ComoCantidad(i.Unidad)</td>
                    <td class="d-none d-lg-table-cell">
                        <div class="progress" style="height: .6rem;">
                            <div class="progress-bar @(i.BajoMinimo ? "bg-danger" : i.NivelStock < 1.5m ? "bg-warning" : "bg-success")"
                                 style="width: @porcentaje.ToString(System.Globalization.CultureInfo.InvariantCulture)%"></div>
                        </div>
                    </td>
                    <td class="text-end text-nowrap d-none d-md-table-cell">@i.CostoUnitario.ComoPesos()/@i.Unidad.Abreviatura()</td>
                    <td>
                        <form asp-action="Reabastecer" asp-route-id="@i.Id" method="post" class="input-group input-group-sm">
                            <input type="number" name="cantidad" class="form-control" min="0.01" step="0.01" placeholder="+ @i.Unidad.Abreviatura()" required />
                            <button class="btn btn-outline-success">Ingresar</button>
                        </form>
                    </td>
                    <td class="text-nowrap">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Editar" asp-route-id="@i.Id">Editar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
