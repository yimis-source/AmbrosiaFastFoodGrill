@model Insumo
@{
    ViewData["Title"] = Model.EsNueva ? "Nuevo insumo" : "Editar " + Model.Nombre;
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <h1 class="h3 mb-3">@ViewData["Title"]</h1>
        <form asp-action="Guardar" method="post" class="card shadow-sm">
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <input type="hidden" asp-for="Id" />
                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="Nombre" class="form-label"></label>
                        <input asp-for="Nombre" class="form-control" />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Unidad" class="form-label">Unidad de medida</label>
                        <select asp-for="Unidad" class="form-select">
                            @foreach (var unidad in Extensiones.Valores<UnidadMedida>())
                            {
                                <option value="@unidad">@unidad.Texto() (@unidad.Abreviatura())</option>
                            }
                        </select>
                    </div>
                    <div class="col-6 col-md-4">
                        <label asp-for="StockActual" class="form-label"></label>
                        <input asp-for="StockActual" class="form-control" type="number" step="0.01" min="0" />
                        <span asp-validation-for="StockActual" class="text-danger small"></span>
                    </div>
                    <div class="col-6 col-md-4">
                        <label asp-for="StockMinimo" class="form-label"></label>
                        <input asp-for="StockMinimo" class="form-control" type="number" step="0.01" min="0" />
                        <span asp-validation-for="StockMinimo" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="CostoUnitario" class="form-label"></label>
                        <input asp-for="CostoUnitario" class="form-control" type="number" step="0.01" min="0" />
                        <span asp-validation-for="CostoUnitario" class="text-danger small"></span>
                    </div>
                </div>
                <p class="form-text mb-0 mt-2">El costo es por gramo, mililitro o unidad, según la unidad elegida.</p>
            </div>
            <div class="card-footer bg-white d-flex gap-2 justify-content-between">
                @if (!Model.EsNueva)
                {
                    <button type="submit" form="formEliminar" class="btn btn-outline-danger">Eliminar</button>
                }
                else
                {
                    <span></span>
                }
                <div class="d-flex gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-fuego">Guardar</button>
                </div>
            </div>
        </form>
        @if (!Model.EsNueva)
        {
            <form id="formEliminar" asp-action="Eliminar" asp-route-id="@Model.Id" method="post"
                  onsubmit="return confirm('¿Eliminar el insumo @Model.Nombre?');"></form>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
