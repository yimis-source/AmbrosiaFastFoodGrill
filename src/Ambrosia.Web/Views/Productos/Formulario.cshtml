@model Producto
@{
    ViewData["Title"] = Model.EsNueva ? "Nuevo producto" : "Editar " + Model.Nombre;
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <h1 class="h3 mb-3">@ViewData["Title"]</h1>
        <form asp-action="Guardar" method="post" class="card shadow-sm">
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <input type="hidden" asp-for="Id" />

                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="Nombre" class="form-label"></label>
                        <input asp-for="Nombre" class="form-control" />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Precio" class="form-label">Precio (COP)</label>
                        <input asp-for="Precio" class="form-control" type="number" step="100" min="500" />
                        <span asp-validation-for="Precio" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Descripcion" class="form-label"></label>
                        <textarea asp-for="Descripcion" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="Descripcion" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="CategoriaId" class="form-label"></label>
                        <select asp-for="CategoriaId" class="form-select" asp-items="ViewBag.Categorias">
                            <option value="0">— Seleccione —</option>
                        </select>
                        <span asp-validation-for="CategoriaId" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="TiempoPreparacionMinutos" class="form-label"></label>
                        <input asp-for="TiempoPreparacionMinutos" class="form-control" />
                        <span asp-validation-for="TiempoPreparacionMinutos" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <div class="form-check form-switch">
                            <input asp-for="Disponible" class="form-check-input" />
                            <label asp-for="Disponible" class="form-check-label"></label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-white d-flex gap-2 justify-content-end">
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                <button type="submit" class="btn btn-fuego">Guardar</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
