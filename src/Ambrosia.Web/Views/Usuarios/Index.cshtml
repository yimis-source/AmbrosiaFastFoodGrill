@model List<UsuarioFilaViewModel>
@{
    ViewData["Title"] = "Usuarios";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">👥 Usuarios y roles</h1>
    <a class="btn btn-fuego" asp-action="Crear">➕ Nuevo usuario</a>
</div>

<div class="table-responsive shadow-sm rounded">
    <table class="table table-striped table-hover align-middle mb-0 bg-white">
        <thead class="table-dark">
            <tr><th>Usuario</th><th class="d-none d-sm-table-cell">Correo</th><th>Rol</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td>
                        <strong>@u.Usuario</strong>
                        @if (u.Bloqueado) { <span class="badge bg-danger ms-1">Bloqueado</span> }
                    </td>
                    <td class="d-none d-sm-table-cell">@u.Email</td>
                    <td>
                        @foreach (var rol in u.Roles)
                        {
                            <span class="badge bg-mostaza me-1">@rol</span>
                        }
                    </td>
                    <td class="text-end">
                        @if (u.Usuario != User.Identity?.Name)
                        {
                            <form asp-action="Eliminar" asp-route-id="@u.Id" method="post"
                                  onsubmit="return confirm('¿Eliminar al usuario @u.Usuario?');">
                                <button class="btn btn-sm btn-outline-danger">Eliminar</button>
                            </form>
                        }
                        else
                        {
                            <span class="small text-muted">(usted)</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="card mt-3 border-0 bg-light">
    <div class="card-body small">
        <strong>Permisos por rol</strong>
        <ul class="mb-0">
            <li><strong>Administrador</strong>: todo (carta, inventario, reportes, usuarios, caja y cocina).</li>
            <li><strong>Cajero</strong>: registrar pedidos, entregarlos y cancelarlos.</li>
            <li><strong>Cocina</strong>: ver la cola, tomar pedidos y marcarlos listos.</li>
        </ul>
    </div>
</div>
