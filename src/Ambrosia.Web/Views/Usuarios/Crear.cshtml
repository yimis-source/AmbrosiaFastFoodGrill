@model CrearUsuarioViewModel
@{
    ViewData["Title"] = "Nuevo usuario";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <h1 class="h3 mb-3">Nuevo usuario</h1>
        <form asp-action="Crear" method="post" class="card shadow-sm">
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <div class="mb-3">
                    <label asp-for="Usuario" class="form-label"></label>
                    <input asp-for="Usuario" class="form-control" autocomplete="off" />
                    <span asp-validation-for="Usuario" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        <label asp-for="Clave" class="form-label"></label>
                        <input asp-for="Clave" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Clave" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="ConfirmarClave" class="form-label"></label>
                        <input asp-for="ConfirmarClave" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmarClave" class="text-danger small"></span>
                    </div>
                </div>
                <div class="form-text mb-3">Debe tener mayúscula, minúscula, número y un símbolo. Ej.: <code>Turno2026*</code></div>
                <div class="mb-1">
                    <label asp-for="Rol" class="form-label"></label>
                    <select asp-for="Rol" class="form-select" asp-items="ViewBag.Roles"></select>
                    <span asp-validation-for="Rol" class="text-danger small"></span>
                </div>
            </div>
            <div class="card-footer bg-white d-flex gap-2 justify-content-end">
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                <button type="submit" class="btn btn-fuego">Crear usuario</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
