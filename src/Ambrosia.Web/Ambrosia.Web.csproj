<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Aplicación web ASP.NET Core MVC (patrón Modelo-Vista-Controlador) -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Ambrosia.Web</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Necesario solo si se quieren crear migraciones con "dotnet ef" -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ambrosia.Nucleo\Ambrosia.Nucleo.csproj" />
  </ItemGroup>

</Project>
